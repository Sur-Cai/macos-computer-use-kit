{
  "name": "dsh-macos-computer-use",
  "version": "0.3.0",
  "description": "AX-first macOS computer use for DeepSeek Harness: accessibility snapshots with stable refs, background input, Unicode typing, menus, apps, set-of-mark screenshots, on-device OCR, verified actions, and optional Jev (TypeSafe System One) semantic guards \u2014 11 tools bridged to the macos-cu CLI.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "macos",
    "computer-use",
    "computer-use-agent",
    "accessibility",
    "accessibility-tree",
    "automation",
    "gui-automation",
    "agent-tools",
    "jev",
    "typesafe-ai",
    "system-one-models"
  ],
  "homepage": "https://github.com/Sur-Cai/macos-computer-use-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sur-Cai/macos-computer-use-kit.git",
    "directory": "packages/dsh"
  },
  "bugs": {
    "url": "https://github.com/Sur-Cai/macos-computer-use-kit/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
